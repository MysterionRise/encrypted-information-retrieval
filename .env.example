# Settings for the local Docker Compose demo. Copy this file before `docker compose up`:
#
#     cp .env.example .env
#
# Every value below is a PUBLIC DEMO VALUE, committed to the repository. Use them only on your
# own machine, and never for real data. Production deployments use AWS KMS for the master key
# and OIDC for authentication instead (see README.md).

POSTGRES_DB=encrypted_ir
POSTGRES_USER=encrypted_ir
POSTGRES_PASSWORD=encrypted_ir_dev_password

# 32 random bytes, base64. Demo only: anyone can decrypt data written under this key.
ENCRYPTED_IR_MASTER_KEY_B64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Dev auth: an API key and an HS256 secret of at least 32 bytes. Demo only.
ENCRYPTED_IR_DEV_API_KEY=local-demo-key
ENCRYPTED_IR_JWT_SECRET=local-docker-demo-secret-change-me
